{
  "name": "building-charge",
  "private": true,
  "version": "1.6.12",
  "versionCode": 20,
  "description": "محاسبه شارژ ساختمان - React + Vite + Capacitor (Android, offline)",
  "type": "module",
  "scripts": {
    "theme:generate": "node scripts/dark-css.mjs && node scripts/dark-art.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "capacitor:copy:after": "node scripts/apply-android-branding.mjs",
    "android:brand": "node scripts/apply-android-branding.mjs",
    "branding:generate": "node resources/branding/generate.mjs",
    "android:sign": "node scripts/sign-release.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/vazirmatn": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
